# ---- Argus SIEM configuration ----
# Copy to .env and edit. All values are optional; sensible defaults are used.

# Secret used to sign session tokens (CHANGE THIS in production)
ARGUS_SECRET=change-me-to-a-long-random-string

# First-run admin account (created automatically if no users exist)
ARGUS_ADMIN_USER=admin
ARGUS_ADMIN_PASSWORD=argus

# VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
# Without it, file/hash/URL reputation lookups run in "offline" mode
# using only the local signature database.
VIRUSTOTAL_API_KEY=

# Shared secret that host agents present when enrolling / sending telemetry
ARGUS_AGENT_KEY=argus-agent-key

# Folder the built-in automated scanner watches (defaults to the user Downloads)
ARGUS_WATCH_DIR=

# Bind address / port
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8642
